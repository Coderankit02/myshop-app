{
  "expo": {
    "name": "Rinku Kirana Store",
    "slug": "rinku-kirana-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rinkukirana",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rinkukiranastore.app"
    },
    "android": {
      "package": "com.rinkukiranastore.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#15803D",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15803D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Delivery distance check karne ke liye location chahiye."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#15803D",
          "defaultChannel": "default",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      "expo-image-picker",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63a0244f-9d5b-4ed4-b215-05cf1c5ff334"
      }
    },
    "owner": "rk-grocery-mart"
  }
}
